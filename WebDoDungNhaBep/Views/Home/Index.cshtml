@model IEnumerable<WebDoDungNhaBep.Models.SanPham>
<partial name="Bannerusers" />
<h2 class="mb-4 text-center">Danh sách sản phẩm</h2>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-5 g-4">
    @foreach (var sp in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(sp.HinhAnh))
                {
                    <img src="@sp.HinhAnh" class="card-img-top" alt="@sp.TenSanPham" style="height:180px; object-fit:cover;">
                }
                <div class="card-body d-flex flex-column">
                    <h6 class="card-title fw-bold">@sp.TenSanPham</h6>
                    <p class="card-text text-truncate" style="height:40px;">@sp.MoTa</p>
                    <p class="card-text text-success fw-bold">@sp.Gia.ToString("C")</p>
                    <p class="card-text text-muted small">@sp.MaDanhMucNavigation?.TenDanhMuc</p>

                    <div class="mt-auto d-flex justify-content-between">
                        <a href="@Url.Action("ThemGioHang", "GioHang", new { id = sp.MaSanPham })"
                           class="btn btn-sm btn-outline-warning" title="Thêm vào giỏ">
                            <i class="fa-solid fa-cart-shopping"></i>
                        </a>

                        <a href="@Url.Action("Details", "SanPham", new { id = sp.MaSanPham })"
                           class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                            <i class="fa-solid fa-eye"></i>
                        </a>

                        <a href="@Url.Action("MuaNgay", "GioHang", new { id = sp.MaSanPham })"
                           class="btn btn-sm btn-outline-success" title="Mua ngay">
                            <i class="fa-solid fa-credit-card"></i>
                        </a>

                    </div>
                </div>
            </div>
        </div>
    }
</div>
