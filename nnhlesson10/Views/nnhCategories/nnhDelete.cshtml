@model nnhlesson09v2.Models.Category

@{
    ViewData["Title"] = "Xóa Thông tin";
    Layout = "~/Views/Shared/_nnhLayout.cshtml";
}

<div class="row">
    <div class="col-md-4">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h2>@ViewData["Title"]</h2>
                <p>Bạn có chắc chắn muốn xóa mục này?</p>
            </div>

            <div class="card-group my-1 px-3 pt-2">
                <label asp-for="CategoryId" class="form-label"></label>
                <input asp-for="CategoryId" class="form-control" readonly />
            </div>

            <div class="card-body">
                <div class="form-group my-1">
                    <label asp-for="CategoryName" class="form-label"></label>
                    <input asp-for="CategoryName" class="form-control" readonly />
                </div>
            </div>

            <div class="card-footer">
                <form asp-action="nnhDelete">
                    <input type="hidden" asp-for="CategoryId" />
                    <input type="submit" value="Xác nhận Xóa" class="btn btn-danger" />
                    <a asp-action="nnhIndex" class="btn btn-secondary ms-2">Quay lại danh sách</a>
                </form>
            </div>
        </div>
    </div>
</div>
