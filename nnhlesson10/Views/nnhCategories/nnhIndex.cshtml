@model IEnumerable<nnhlesson09v2.Models.Category>

@{
    ViewData["Title"] = "Danh sách loại sách";
    Layout = "~/Views/Shared/_nnhLayout.cshtml";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="nnhCreate">Thêm mới</a>
</p>
<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CategoryId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CategoryName)
            </th>
            <th class="text-center">Chức Năng</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayNameFor(modelItem => item.CategoryId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CategoryName)
                </td>
            <td>
                    <a asp-action="nnhEdit" asp-route-nnhId="@item.CategoryId" class="btn btn-primary">Sửa</a> |
                    <a asp-action="nnhDetails" asp-route-nnhId="@item.CategoryId" class="btn btn-info">Xem</a> |
                    <a asp-action="nnhDelete" asp-route-nnhId="@item.CategoryId" class="btn btn-danger">Xóa</a>
            </td>
        </tr>
}
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3">Tong so: @Model.Count()</th>
        </tr>
    </tfoot>
</table>
